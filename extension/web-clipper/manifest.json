{
    "manifest_version": 3,
    "name": "pnkx 网址收藏",
    "version": "1.0.0",
    "description": "一键收藏当前网页到 pnkx，自动抓取正文并 AI 整理摘要标签",
    "permissions": ["activeTab", "storage", "notifications"],
    "host_permissions": ["http://*/*", "https://*/*"],
    "action": {
        "default_popup": "popup.html",
        "default_title": "收藏到 pnkx",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_page": "options.html",
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "commands": {
        "quick-save": {
            "suggested_key": {
                "default": "Ctrl+Shift+S",
                "mac": "Command+Shift+S"
            },
            "description": "一键收藏当前网页"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
