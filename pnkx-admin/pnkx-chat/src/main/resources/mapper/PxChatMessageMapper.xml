<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pnkx.mapper.PxChatMessageMapper">

    <resultMap type="PxChatMessage" id="PxChatMessageResult">
        <result property="id" column="id"/>
        <result property="messageId" column="message_id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="groupId" column="group_id"/>
        <result property="groupName" column="group_name"/>
        <result property="content" column="content"/>
        <result property="messageType" column="message_type"/>
        <result property="createTime" column="create_time"/>
        <result property="isBotReply" column="is_bot_reply"/>
        <result property="botReplyContent" column="bot_reply_content"/>
        <result property="deleted" column="deleted"/>
        <result property="createAt" column="create_at"/>
        <result property="updateAt" column="update_at"/>
    </resultMap>

    <select id="selectByUserIdWithLimit" resultMap="PxChatMessageResult">
        SELECT *
        FROM px_chat_message
        WHERE user_id = #{userId}
          AND deleted = 0
        ORDER BY create_time DESC LIMIT #{limit}
    </select>

    <select id="selectByGroupIdWithLimit" resultMap="PxChatMessageResult">
        SELECT *
        FROM px_chat_message
        WHERE group_id = #{groupId}
          AND deleted = 0
        ORDER BY create_time DESC LIMIT #{limit}
    </select>

    <select id="selectByTimeRange" resultMap="PxChatMessageResult">
        SELECT * FROM px_chat_message WHERE create_time >= #{startTime} AND create_time &lt;= #{endTime} AND deleted = 0
        ORDER BY create_time DESC
    </select>

    <select id="selectByMessageId" resultMap="PxChatMessageResult">
        SELECT *
        FROM px_chat_message
        WHERE message_id = #{messageId}
          AND deleted = 0
    </select>

    <sql id="selectPxChatMessageVo">
        select id, message_id, user_id, user_name, group_id, group_name, content, message_type, create_time, is_bot_reply, bot_reply_content, deleted, create_at, update_at        from px_chat_message
    </sql>

    <select id="selectPxChatMessageList" parameterType="PxChatMessage" resultMap="PxChatMessageResult">
        <include refid="selectPxChatMessageVo"/>
        <where>
            <if test="messageId != null  and messageId != ''">
                and message_id = #{messageId}
            </if>
            <if test="userId != null  and userId != ''">
                and user_id = #{userId}
            </if>
            <if test="userName != null  and userName != ''">
                and user_name like concat('%', #{userName}, '%')
            </if>
            <if test="groupId != null  and groupId != ''">
                and group_id = #{groupId}
            </if>
            <if test="groupName != null  and groupName != ''">
                and group_name like concat('%', #{groupName}, '%')
            </if>
            <if test="content != null  and content != ''">
                and content = #{content}
            </if>
            <if test="messageType != null  and messageType != ''">
                and message_type = #{messageType}
            </if>
            <if test="isBotReply != null ">
                and is_bot_reply = #{isBotReply}
            </if>
            <if test="botReplyContent != null  and botReplyContent != ''">
                and bot_reply_content = #{botReplyContent}
            </if>
            <if test="deleted != null ">
                and deleted = #{deleted}
            </if>
            <if test="createAt != null ">
                and create_at = #{createAt}
            </if>
            <if test="updateAt != null ">
                and update_at = #{updateAt}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectPxChatMessageById" parameterType="Long"
            resultMap="PxChatMessageResult">
        <include refid="selectPxChatMessageVo"/>
        where id = #{id}
    </select>

    <select id="count" resultType="java.lang.Long">
        select count(1) from px_chat_message where deleted = 0
    </select>

    <insert id="insertPxChatMessage" parameterType="PxChatMessage" useGeneratedKeys="true"
            keyProperty="id">
        insert into px_chat_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="messageId != null and messageId != ''">message_id,
            </if>
            <if test="userId != null">user_id,
            </if>
            <if test="userName != null">user_name,
            </if>
            <if test="groupId != null">group_id,
            </if>
            <if test="groupName != null">group_name,
            </if>
            <if test="content != null">content,
            </if>
            <if test="messageType != null">message_type,
            </if>
            <if test="createTime != null">create_time,
            </if>
            <if test="isBotReply != null">is_bot_reply,
            </if>
            <if test="botReplyContent != null">bot_reply_content,
            </if>
            <if test="deleted != null">deleted,
            </if>
            <if test="createAt != null">create_at,
            </if>
            <if test="updateAt != null">update_at,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="messageId != null and messageId != ''">#{messageId},
            </if>
            <if test="userId != null">#{userId},
            </if>
            <if test="userName != null">#{userName},
            </if>
            <if test="groupId != null">#{groupId},
            </if>
            <if test="groupName != null">#{groupName},
            </if>
            <if test="content != null">#{content},
            </if>
            <if test="messageType != null">#{messageType},
            </if>
            <if test="createTime != null">#{createTime},
            </if>
            <if test="isBotReply != null">#{isBotReply},
            </if>
            <if test="botReplyContent != null">#{botReplyContent},
            </if>
            <if test="deleted != null">#{deleted},
            </if>
            <if test="createAt != null">#{createAt},
            </if>
            <if test="updateAt != null">#{updateAt},
            </if>
        </trim>
    </insert>

    <update id="updatePxChatMessage" parameterType="PxChatMessage">
        update px_chat_message
        <trim prefix="SET" suffixOverrides=",">
            <if test="messageId != null and messageId != ''">message_id =
                #{messageId},
            </if>
            <if test="userId != null">user_id =
                #{userId},
            </if>
            <if test="userName != null">user_name =
                #{userName},
            </if>
            <if test="groupId != null">group_id =
                #{groupId},
            </if>
            <if test="groupName != null">group_name =
                #{groupName},
            </if>
            <if test="content != null">content =
                #{content},
            </if>
            <if test="messageType != null">message_type =
                #{messageType},
            </if>
            <if test="createTime != null">create_time =
                #{createTime},
            </if>
            <if test="isBotReply != null">is_bot_reply =
                #{isBotReply},
            </if>
            <if test="botReplyContent != null">bot_reply_content =
                #{botReplyContent},
            </if>
            <if test="deleted != null">deleted =
                #{deleted},
            </if>
            <if test="createAt != null">create_at =
                #{createAt},
            </if>
            <if test="updateAt != null">update_at =
                #{updateAt},
            </if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePxChatMessageById" parameterType="Long">
        delete
        from px_chat_message where id = #{id}
    </delete>

    <delete id="deletePxChatMessageByIds" parameterType="String">
        delete from px_chat_message where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
