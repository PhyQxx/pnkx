<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pnkx.mapper.PxAutomationMapper">
    <resultMap id="RuleResult" type="PxAutomationRule">
        <id property="id" column="id"/><result property="clientUuid" column="client_uuid"/>
        <result property="name" column="name"/><result property="templateCode" column="template_code"/>
        <result property="triggerType" column="trigger_type"/><result property="triggerConfig" column="trigger_config"/>
        <result property="conditionJson" column="condition_json"/><result property="actionType" column="action_type"/>
        <result property="actionConfig" column="action_config"/><result property="enabled" column="enabled"/>
        <result property="version" column="version"/><result property="lastRunTime" column="last_run_time"/>
        <result property="nextRunTime" column="next_run_time"/><result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/><result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <resultMap id="ExecutionResult" type="PxAutomationExecution">
        <id property="id" column="id"/><result property="ruleId" column="rule_id"/>
        <result property="idempotencyKey" column="idempotency_key"/><result property="status" column="status"/>
        <result property="dryRun" column="dry_run"/><result property="inputJson" column="input_json"/>
        <result property="planJson" column="plan_json"/><result property="resultJson" column="result_json"/>
        <result property="errorMsg" column="error_msg"/><result property="retryOf" column="retry_of"/>
        <result property="startTime" column="start_time"/><result property="finishTime" column="finish_time"/>
        <result property="createBy" column="create_by"/><result property="createTime" column="create_time"/>
    </resultMap>
    <sql id="ruleColumns">id,client_uuid,name,template_code,trigger_type,trigger_config,condition_json,action_type,action_config,enabled,version,last_run_time,next_run_time,del_flag,create_by,create_time,update_by,update_time,remark</sql>
    <select id="selectRules" resultMap="RuleResult">select <include refid="ruleColumns"/> from px_automation_rule where create_by=#{userId} and del_flag='0' order by enabled desc, update_time desc, id desc</select>
    <select id="selectDueRules" resultMap="RuleResult">select <include refid="ruleColumns"/> from px_automation_rule where enabled=1 and trigger_type='schedule' and next_run_time is not null and next_run_time &lt;= #{now} and del_flag='0' order by next_run_time limit 100</select>
    <select id="selectRule" resultMap="RuleResult">select <include refid="ruleColumns"/> from px_automation_rule where id=#{id} and create_by=#{userId} and del_flag='0'</select>
    <select id="selectRuleByClientUuid" resultMap="RuleResult">select <include refid="ruleColumns"/> from px_automation_rule where client_uuid=#{clientUuid} and create_by=#{userId} and del_flag='0' limit 1</select>
    <insert id="insertRule" useGeneratedKeys="true" keyProperty="id">
        insert into px_automation_rule(client_uuid,name,template_code,trigger_type,trigger_config,condition_json,action_type,action_config,enabled,version,next_run_time,del_flag,create_by,create_time,remark)
        values(#{clientUuid},#{name},#{templateCode},#{triggerType},#{triggerConfig},#{conditionJson},#{actionType},#{actionConfig},#{enabled},#{version},#{nextRunTime},'0',#{createBy},#{createTime},#{remark})
    </insert>
    <update id="updateRule">
        update px_automation_rule set name=#{name},template_code=#{templateCode},trigger_type=#{triggerType},trigger_config=#{triggerConfig},condition_json=#{conditionJson},action_type=#{actionType},action_config=#{actionConfig},enabled=#{enabled},version=#{version},next_run_time=#{nextRunTime},update_by=#{updateBy},update_time=#{updateTime},remark=#{remark}
        where id=#{id} and create_by=#{updateBy} and del_flag='0'
    </update>
    <update id="deleteRule">update px_automation_rule set del_flag='1',update_by=#{userId},update_time=now() where id=#{id} and create_by=#{userId} and del_flag='0'</update>
    <update id="updateRunTime">update px_automation_rule set last_run_time=#{lastRunTime},next_run_time=#{nextRunTime},update_time=now() where id=#{id} and create_by=#{userId} and del_flag='0'</update>
    <select id="selectExecutions" resultMap="ExecutionResult">select * from px_automation_execution where create_by=#{userId}<if test="ruleId != null"> and rule_id=#{ruleId}</if> order by create_time desc limit 100</select>
    <select id="selectExecution" resultMap="ExecutionResult">select * from px_automation_execution where id=#{id} and create_by=#{userId}</select>
    <select id="selectExecutionByKey" resultMap="ExecutionResult">select * from px_automation_execution where idempotency_key=#{key} limit 1</select>
    <insert id="insertExecution" useGeneratedKeys="true" keyProperty="id">
        insert into px_automation_execution(rule_id,idempotency_key,status,dry_run,input_json,plan_json,result_json,error_msg,retry_of,start_time,finish_time,create_by,create_time)
        values(#{ruleId},#{idempotencyKey},#{status},#{dryRun},#{inputJson},#{planJson},#{resultJson},#{errorMsg},#{retryOf},#{startTime},#{finishTime},#{createBy},#{createTime})
    </insert>
    <update id="updateExecution">update px_automation_execution set status=#{status},result_json=#{resultJson},error_msg=#{errorMsg},finish_time=#{finishTime} where id=#{id} and create_by=#{createBy}</update>
</mapper>
