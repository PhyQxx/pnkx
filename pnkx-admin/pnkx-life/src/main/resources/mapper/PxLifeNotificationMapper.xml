<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pnkx.mapper.PxLifeNotificationMapper">

    <resultMap type="PxLifeNotification" id="PxLifeNotificationResult">
        <result property="id" column="id"/>
        <result property="reminderId" column="reminder_id"/>
        <result property="userId" column="user_id"/>
        <result property="channel" column="channel"/>
        <result property="sourceType" column="source_type"/>
        <result property="sourceId" column="source_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="sendTime" column="send_time"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insertPxLifeNotification" parameterType="PxLifeNotification"
            useGeneratedKeys="true" keyProperty="id">
        insert into px_life_notification
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="reminderId != null">reminder_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="channel != null">channel,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="title != null">title,</if>
            <if test="content != null">content,</if>
            <if test="sendTime != null">send_time,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="reminderId != null">#{reminderId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="channel != null">#{channel},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="title != null">#{title},</if>
            <if test="content != null">#{content},</if>
            <if test="sendTime != null">#{sendTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <select id="selectByUser" resultMap="PxLifeNotificationResult">
        select id, reminder_id, user_id, channel, source_type, source_id,
               title, content, send_time, status, create_time
        from px_life_notification
        where user_id = #{userId}
        <if test="status != null and status != ''">
            and status = #{status}
        </if>
        order by send_time desc
        limit 100
    </select>

    <select id="countUnread" resultType="int">
        select count(1)
        from px_life_notification
        where user_id = #{userId}
          and status = '0'
    </select>

    <update id="markRead">
        update px_life_notification
        set status = '2'
        where user_id = #{userId}
        and status = '0'
        <if test="ids != null and ids.length > 0">
            and id in
            <foreach item="id" collection="ids" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
    </update>

    <delete id="deleteByUser">
        delete from px_life_notification where user_id = #{userId} and id = #{id}
    </delete>
</mapper>
