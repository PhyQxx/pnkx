<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pnkx.life.mapper.OrganizeMapper">
  <resultMap id="suggestion" type="com.pnkx.life.service.workspace.OrganizeSuggestion">
    <id property="id" column="id"/><result property="ownerId" column="owner_id"/><result property="resourceType" column="resource_type"/><result property="resourceId" column="resource_id"/><result property="ruleCode" column="rule_code"/><result property="fingerprint" column="fingerprint"/><result property="title" column="title"/><result property="reason" column="reason"/><result property="proposedTitle" column="proposed_title"/><result property="status" column="status"/>
  </resultMap>
  <insert id="insert">insert ignore into px_organize_suggestion(owner_id,resource_type,resource_id,rule_code,fingerprint,title,reason,proposed_title)
    values(#{ownerId},#{resourceType},#{resourceId},#{ruleCode},#{fingerprint},#{title},#{reason},#{proposedTitle})</insert>
  <select id="list" resultMap="suggestion">select * from px_organize_suggestion where owner_id=#{owner} and id &gt; #{after} and status='ready' order by id limit 100</select>
  <select id="lock" resultMap="suggestion">select * from px_organize_suggestion where owner_id=#{owner} and id=#{id} for update</select>
  <update id="status">update px_organize_suggestion set status=#{status},update_time=CURRENT_TIMESTAMP where id=#{id} and owner_id=#{owner}</update>
</mapper>
