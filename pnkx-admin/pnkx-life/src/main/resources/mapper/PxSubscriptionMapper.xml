<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pnkx.mapper.PxSubscriptionMapper">

    <resultMap type="PxSubscription" id="PxSubscriptionResult">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="amount" column="amount"/>
        <result property="cycle" column="cycle"/>
        <result property="cycleInterval" column="cycle_interval"/>
        <result property="nextPaymentDate" column="next_payment_date"/>
        <result property="accountId" column="account_id"/>
        <result property="classificationId" column="classification_id"/>
        <result property="paymentMethod" column="payment_method"/>
        <result property="logo" column="logo"/>
        <result property="reminderLeadDays" column="reminder_lead_days"/>
        <result property="enabled" column="enabled"/>
        <result property="version" column="version"/>
        <result property="clientUuid" column="client_uuid"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectPxSubscriptionVo">
        select id, name, amount, cycle, cycle_interval, next_payment_date, account_id, classification_id,
               payment_method, logo, reminder_lead_days, enabled, version, client_uuid, del_flag,
               create_by, create_time, update_by, update_time, remark
        from px_subscription
    </sql>

    <select id="selectPxSubscriptionList" parameterType="PxSubscription" resultMap="PxSubscriptionResult">
        <include refid="selectPxSubscriptionVo"/>
        <where>
            del_flag = '0'
            <if test="name != null and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="cycle != null and cycle != ''">and cycle = #{cycle}</if>
            <if test="enabled != null">and enabled = #{enabled}</if>
            <if test="version != null and version != ''">and version = #{version}</if>
            <if test="params != null and params.scopeAll != true and params.scopeUserIds != null">
                and create_by in
                <foreach collection="params.scopeUserIds" item="uid" open="(" separator="," close=")">
                    #{uid}
                </foreach>
            </if>
        </where>
        order by next_payment_date asc
    </select>

    <select id="selectPxSubscriptionById" parameterType="Long" resultMap="PxSubscriptionResult">
        <include refid="selectPxSubscriptionVo"/>
        where id = #{id}
    </select>

    <!-- 查询已到期且启用的订阅 -->
    <select id="selectDueSubscriptions" resultMap="PxSubscriptionResult">
        <include refid="selectPxSubscriptionVo"/>
        where enabled = 1
          and del_flag = '0'
          and next_payment_date &lt;= #{now}
    </select>

    <insert id="insertPxSubscription" parameterType="PxSubscription" useGeneratedKeys="true" keyProperty="id">
        insert into px_subscription
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="amount != null">amount,</if>
            <if test="cycle != null">cycle,</if>
            <if test="cycleInterval != null">cycle_interval,</if>
            <if test="nextPaymentDate != null">next_payment_date,</if>
            <if test="accountId != null">account_id,</if>
            <if test="classificationId != null">classification_id,</if>
            <if test="paymentMethod != null">payment_method,</if>
            <if test="logo != null">logo,</if>
            <if test="reminderLeadDays != null">reminder_lead_days,</if>
            <if test="enabled != null">enabled,</if>
            <if test="version != null">version,</if>
            <if test="clientUuid != null">client_uuid,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="amount != null">#{amount},</if>
            <if test="cycle != null">#{cycle},</if>
            <if test="cycleInterval != null">#{cycleInterval},</if>
            <if test="nextPaymentDate != null">#{nextPaymentDate},</if>
            <if test="accountId != null">#{accountId},</if>
            <if test="classificationId != null">#{classificationId},</if>
            <if test="paymentMethod != null">#{paymentMethod},</if>
            <if test="logo != null">#{logo},</if>
            <if test="reminderLeadDays != null">#{reminderLeadDays},</if>
            <if test="enabled != null">#{enabled},</if>
            <if test="version != null">#{version},</if>
            <if test="clientUuid != null">#{clientUuid},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePxSubscription" parameterType="PxSubscription">
        update px_subscription
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="cycle != null">cycle = #{cycle},</if>
            <if test="cycleInterval != null">cycle_interval = #{cycleInterval},</if>
            <if test="nextPaymentDate != null">next_payment_date = #{nextPaymentDate},</if>
            <if test="accountId != null">account_id = #{accountId},</if>
            <if test="classificationId != null">classification_id = #{classificationId},</if>
            <if test="paymentMethod != null">payment_method = #{paymentMethod},</if>
            <if test="logo != null">logo = #{logo},</if>
            <if test="reminderLeadDays != null">reminder_lead_days = #{reminderLeadDays},</if>
            <if test="enabled != null">enabled = #{enabled},</if>
            <if test="version != null">version = #{version},</if>
            <if test="clientUuid != null">client_uuid = #{clientUuid},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePxSubscriptionById" parameterType="Long">
        update px_subscription set del_flag = '1' where id = #{id}
    </delete>

    <delete id="deletePxSubscriptionByIds" parameterType="String">
        update px_subscription set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
