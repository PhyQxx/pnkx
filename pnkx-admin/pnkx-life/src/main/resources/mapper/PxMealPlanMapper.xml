<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pnkx.mapper.PxMealPlanMapper">

    <resultMap type="PxMealPlan" id="PxMealPlanResult">
        <result property="id" column="id"/>
        <result property="planDate" column="plan_date"/>
        <result property="mealType" column="meal_type"/>
        <result property="recipeId" column="recipe_id"/>
        <result property="title" column="title"/>
        <result property="notes" column="notes"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="delFlag" column="del_flag"/>
        <result property="version" column="version"/>
        <result property="clientUuid" column="client_uuid"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectPxMealPlanVo">
        select id,
               plan_date,
               meal_type,
               recipe_id,
               title,
               notes, sort_order, del_flag, version, client_uuid, create_by, create_time, update_by, update_time, remark
        from px_meal_plan
    </sql>

    <select id="selectPxMealPlanList" parameterType="PxMealPlan" resultMap="PxMealPlanResult">
        <include refid="selectPxMealPlanVo"/>
        <where>
            <if test="planDate != null  and planDate != ''">and plan_date = #{planDate}</if>
            <if test="mealType != null ">and meal_type = #{mealType}</if>
            and del_flag = '0'
            <if test="params != null and params.scopeAll != true and params.scopeUserIds != null">
                and create_by in
                <foreach collection="params.scopeUserIds" item="uid" open="(" separator="," close=")">
                    #{uid}
                </foreach>
            </if>
        </where>
        order by plan_date asc, meal_type asc, sort_order asc
    </select>

    <select id="selectPxMealPlanById" parameterType="Long" resultMap="PxMealPlanResult">
        <include refid="selectPxMealPlanVo"/>
        where id = #{id}
    </select>

    <select id="selectByClientUuid" parameterType="String" resultMap="PxMealPlanResult">
        <include refid="selectPxMealPlanVo"/>
        where client_uuid = #{clientUuid}
        limit 1
    </select>

    <!-- 按日期范围查询 -->
    <select id="selectByDateRange" resultMap="PxMealPlanResult">
        <include refid="selectPxMealPlanVo"/>
        where del_flag = '0'
        and plan_date between #{startDate} and #{endDate}
        order by plan_date, meal_type, sort_order
    </select>

    <insert id="insertPxMealPlan" parameterType="PxMealPlan" useGeneratedKeys="true" keyProperty="id">
        insert into px_meal_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planDate != null">plan_date,</if>
            <if test="mealType != null">meal_type,</if>
            <if test="recipeId != null">recipe_id,</if>
            <if test="title != null">title,</if>
            <if test="notes != null">notes,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="version != null">version,</if>
            <if test="clientUuid != null">client_uuid,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planDate != null">#{planDate},</if>
            <if test="mealType != null">#{mealType},</if>
            <if test="recipeId != null">#{recipeId},</if>
            <if test="title != null">#{title},</if>
            <if test="notes != null">#{notes},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="version != null">#{version},</if>
            <if test="clientUuid != null">#{clientUuid},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePxMealPlan" parameterType="PxMealPlan">
        update px_meal_plan
        <trim prefix="SET" suffixOverrides=",">
            <if test="planDate != null">plan_date = #{planDate},</if>
            <if test="mealType != null">meal_type = #{mealType},</if>
            <if test="recipeId != null">recipe_id = #{recipeId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="notes != null">notes = #{notes},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="version != null">version = #{version},</if>
            <if test="clientUuid != null">client_uuid = #{clientUuid},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePxMealPlanById" parameterType="Long">
        update px_meal_plan
        set del_flag = 1
        where id = #{id}
    </delete>

    <delete id="deletePxMealPlanByIds" parameterType="String">
        update px_meal_plan set del_flag = 1 where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
