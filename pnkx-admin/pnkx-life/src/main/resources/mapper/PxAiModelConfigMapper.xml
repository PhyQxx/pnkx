<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pnkx.mapper.PxAiModelConfigMapper">

    <resultMap type="com.pnkx.domain.po.PxAiModelConfig" id="PxAiModelConfigResult">
        <result property="id" column="id"/>
        <result property="modelName" column="model_name"/>
        <result property="modelKey" column="model_key"/>
        <result property="baseUrl" column="base_url"/>
        <result property="apiKey" column="api_key"/>
        <result property="isDefault" column="is_default"/>
        <result property="isEnabled" column="is_enabled"/>
        <result property="temperature" column="temperature"/>
        <result property="sort" column="sort"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectPxAiModelConfigVo">
        SELECT id, model_name, model_key, base_url, api_key, is_default, is_enabled, temperature, sort, del_flag, create_by, create_time, update_by, update_time, remark
        FROM px_ai_model_config
    </sql>

    <select id="selectPxAiModelConfigList" parameterType="com.pnkx.domain.po.PxAiModelConfig" resultMap="PxAiModelConfigResult">
        <include refid="selectPxAiModelConfigVo"/>
        <where>
            del_flag = 0
            <if test="modelName != null and modelName != ''">AND model_name LIKE CONCAT('%', #{modelName}, '%')</if>
            <if test="modelKey != null and modelKey != ''">AND model_key = #{modelKey}</if>
            <if test="isDefault != null and isDefault != ''">AND is_default = #{isDefault}</if>
            <if test="isEnabled != null and isEnabled != ''">AND is_enabled = #{isEnabled}</if>
            <!-- 数据权限：默认仅本人+群组成员，管理员不限 -->
            <if test="params != null and params.scopeAll != true and params.scopeUserIds != null">
                and create_by in
                <foreach collection="params.scopeUserIds" item="uid" open="(" separator="," close=")">
                    #{uid}
                </foreach>
            </if>
        </where>
        ORDER BY sort ASC, id DESC
    </select>

    <select id="selectPxAiModelConfigById" parameterType="Long" resultMap="PxAiModelConfigResult">
        <include refid="selectPxAiModelConfigVo"/>
        WHERE id = #{id} AND del_flag = 0
    </select>

    <select id="selectDefaultEnabledModel" resultMap="PxAiModelConfigResult">
        <include refid="selectPxAiModelConfigVo"/>
        WHERE del_flag = 0 AND is_enabled = '1' AND is_default = '1'
        LIMIT 1
    </select>

    <insert id="insertPxAiModelConfig" parameterType="com.pnkx.domain.po.PxAiModelConfig" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO px_ai_model_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="modelName != null">model_name,</if>
            <if test="modelKey != null">model_key,</if>
            <if test="baseUrl != null">base_url,</if>
            <if test="apiKey != null">api_key,</if>
            <if test="isDefault != null">is_default,</if>
            <if test="isEnabled != null">is_enabled,</if>
            <if test="temperature != null">temperature,</if>
            <if test="sort != null">sort,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="modelName != null">#{modelName},</if>
            <if test="modelKey != null">#{modelKey},</if>
            <if test="baseUrl != null">#{baseUrl},</if>
            <if test="apiKey != null">#{apiKey},</if>
            <if test="isDefault != null">#{isDefault},</if>
            <if test="isEnabled != null">#{isEnabled},</if>
            <if test="temperature != null">#{temperature},</if>
            <if test="sort != null">#{sort},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePxAiModelConfig" parameterType="com.pnkx.domain.po.PxAiModelConfig">
        UPDATE px_ai_model_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="modelName != null">model_name = #{modelName},</if>
            <if test="modelKey != null">model_key = #{modelKey},</if>
            <if test="baseUrl != null">base_url = #{baseUrl},</if>
            <if test="apiKey != null">api_key = #{apiKey},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
            <if test="isEnabled != null">is_enabled = #{isEnabled},</if>
            <if test="temperature != null">temperature = #{temperature},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        WHERE id = #{id}
    </update>

    <delete id="deletePxAiModelConfigById" parameterType="Long">
        UPDATE px_ai_model_config SET del_flag = 1 WHERE id = #{id}
    </delete>

    <delete id="deletePxAiModelConfigByIds" parameterType="Long">
        UPDATE px_ai_model_config SET del_flag = 1 WHERE id IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="clearDefaultFlag">
        UPDATE px_ai_model_config SET is_default = '0' WHERE is_default = '1'
    </update>

    <update id="setDefault" parameterType="Long">
        UPDATE px_ai_model_config SET is_default = '1' WHERE id = #{id}
    </update>

</mapper>
