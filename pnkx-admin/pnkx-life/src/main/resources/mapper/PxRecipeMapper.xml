<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pnkx.mapper.PxRecipeMapper">

    <resultMap type="PxRecipe" id="PxRecipeResult">
        <result property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="url" column="url"/>
        <result property="notes" column="notes"/>
        <result property="servings" column="servings"/>
        <result property="delFlag" column="del_flag"/>
        <result property="version" column="version"/>
        <result property="clientUuid" column="client_uuid"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectPxRecipeVo">
        select id,
               title,
               url,
               notes, servings, del_flag, version, client_uuid, create_by, create_time, update_by, update_time, remark
        from px_recipe
    </sql>

    <select id="selectPxRecipeList" parameterType="PxRecipe" resultMap="PxRecipeResult">
        <include refid="selectPxRecipeVo"/>
        <where>
            <if test="title != null  and title != ''">and title like concat('%', #{title}, '%')</if>
            <if test="servings != null ">and servings = #{servings}</if>
            and del_flag = '0'
        </where>
    </select>

    <select id="selectPxRecipeById" parameterType="Long" resultMap="PxRecipeResult">
        <include refid="selectPxRecipeVo"/>
        where id = #{id}
    </select>

    <insert id="insertPxRecipe" parameterType="PxRecipe" useGeneratedKeys="true" keyProperty="id">
        insert into px_recipe
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null">title,</if>
            <if test="url != null">url,</if>
            <if test="notes != null">notes,</if>
            <if test="servings != null">servings,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="version != null">version,</if>
            <if test="clientUuid != null">client_uuid,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null">#{title},</if>
            <if test="url != null">#{url},</if>
            <if test="notes != null">#{notes},</if>
            <if test="servings != null">#{servings},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="version != null">#{version},</if>
            <if test="clientUuid != null">#{clientUuid},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePxRecipe" parameterType="PxRecipe">
        update px_recipe
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null">title = #{title},</if>
            <if test="url != null">url = #{url},</if>
            <if test="notes != null">notes = #{notes},</if>
            <if test="servings != null">servings = #{servings},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="version != null">version = #{version},</if>
            <if test="clientUuid != null">client_uuid = #{clientUuid},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePxRecipeById" parameterType="Long">
        update px_recipe
        set del_flag = 1
        where id = #{id}
    </delete>

    <delete id="deletePxRecipeByIds" parameterType="String">
        update px_recipe set del_flag = 1 where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
